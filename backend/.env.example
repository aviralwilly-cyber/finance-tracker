# Copy this file to .env and fill in your real key.
# Get a free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: change the backend port (defaults to 8080)
PORT=8080

# --- Deployment only (leave unset for local development) ---

# The full contents of serviceAccountKey.json, as a single line of JSON.
# Used instead of the file when deploying, since secrets can't be committed.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# The deployed frontend's origin, e.g. https://your-app.vercel.app
# Restricts CORS to just that site. Unset means "allow any origin", which
# is fine locally but shouldn't be the case in production.
# FRONTEND_URL=

# Optional: enables the "Deep analysis" agent (Nemotron via OpenRouter).
# Free tier at https://openrouter.ai/keys — 200 requests/day.
# Without this, deep analysis is disabled; everything else works normally.
OPENROUTER_API_KEY=
